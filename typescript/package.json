{
  "name": "@adverserial/sdk",
  "version": "0.1.0",
  "description": "Client-side verification SDK for Adverserial confidential-inference endpoints: attestation verification + TLS binding, for browsers and Node 18+",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node test/node-dev-test.mjs && node test/inference-receipt-test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@phala/dcap-qvl": "0.6.5",
    "ehbp": "0.3.3"
  }
}
